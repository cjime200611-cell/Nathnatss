
{
  // Excluir archivos generados del explorador
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/coverage": true,
    "**/.angular": true,
    "**/out": true
  },

  // Reducir archivos encontrados por las búsquedas del agente
  "search.exclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/coverage/**": true,
    "**/.angular/**": true,
    "**/out/**": true,
    "**/*.min.js": true,
    "**/*.map": true,
    "**/*.log": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/yarn.lock": true
  },

  // Controlar las iteraciones del Agent
  "chat.agent.maxRequests": 8,

  // Evitar correcciones automáticas adicionales
  "github.copilot.chat.agent.autoFix": false,

  // Evitar agentes secundarios innecesarios
  "chat.subagents.allowInvocationsFromSubagents": false
}
